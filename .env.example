# ─── Site ─────────────────────────────────────────────────────────────────────
# Public URL of this site, e.g. https://skills.citrusarc.studio
# Used for canonical/sitemap/share-image URLs, CHIP redirects and callback, and
# the tutorial link in emails. Leave empty locally (http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# ─── Analytics ────────────────────────────────────────────────────────────────
# Google Tag Manager container (GA4 is configured inside GTM). Loads in
# production builds only, with Consent Mode: no analytics cookies until the
# visitor allows them. Defaults to GTM-K9CKZQXK when empty.
NEXT_PUBLIC_GTM_ID=GTM-K9CKZQXK

# ─── CHIP Collect ─────────────────────────────────────────────────────────────
# Citrus Arc Studio brand (CHIP dashboard → Developers → Keys), same as
# citrus-class-v1. Local: the test account key. Production: the live key.
CHIP_API_URL=https://gate.chip-in.asia/api/v1
CHIP_API_KEY=
CHIP_BRAND_ID=
# Optional: CHIP's public key for checking callbacks. Fetched from CHIP when empty.
# CHIP_PUBLIC_KEY=

# ─── Mailjet (buyer email with the zip + sale email to the studio) ────────────
# Same as citrus-class-v1. MAIL_FROM must be an active sender on citrusarc.studio.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=noreply@citrusarc.studio
MAIL_FROM_NAME=Citrus Arc Studio
# Gets the "Jualan baru" email for every sale. Leave empty to turn it off.
ADMIN_EMAIL=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Sent-email log, sales/download counts and alerts. Needed on serverless hosts
# (Vercel/Cloudflare). Can be the same database as citrus-class-v1: every key
# here starts with "meta-ads:". Leave empty locally (.data/kv.json is used).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
