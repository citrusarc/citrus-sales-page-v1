# CHIP Collect — Citrus Arc Studio brand (CHIP dashboard → Developers → Keys).
# Local: the test account key. Production: swap in the live key.
CHIP_API_URL=https://gate.chip-in.asia/api/v1
CHIP_API_KEY=
CHIP_BRAND_ID=
# Optional: CHIP's public key for checking callbacks. Fetched from CHIP when empty.
# CHIP_PUBLIC_KEY=

# Public URL of this site (redirects, CHIP callback, tutorial link in the email).
# Leave empty locally. Set it in production, e.g. https://skills.citrusarc.studio
NEXT_PUBLIC_SITE_URL=

# Mailjet — sends the skill zip to the buyer after payment (same as citrus-class-v1).
# MAIL_FROM must be an active sender on citrusarc.studio.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=
MAIL_FROM_NAME=
# Optional: gets a short "new sale" email for every purchase.
ADMIN_EMAIL=

# Upstash Redis — remembers which purchases were already emailed, so nobody
# gets the file twice. Needed on serverless hosts (Vercel/Cloudflare).
# Leave empty locally: a .data/mailed.json file is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
